# Supabase — get these from your project settings at https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://daahzybrfmlotpoigmtt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key ("service_role" under Project settings → API keys). Required:
# Stripe webhooks, credit grants and video uploads all run without a user
# session and are rejected by RLS without it. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Danish (DKK) subscription price. Leave blank to bill via an inline price.
STRIPE_PRICE_SOCIAL_MONTHLY=
# Optional EUR subscription price for non-Danish languages. Leave blank to
# bill via an inline EUR price instead of a pre-created Stripe Price.
STRIPE_PRICE_SOCIAL_MONTHLY_EUR=

# Anthropic — get an API key from https://console.anthropic.com/settings/keys
# Required for AI post text (/api/generate-post) and video captions
# (/api/generate-video-caption). Without it both return HTTP 500 and no
# description can be generated from a pasted link.
ANTHROPIC_API_KEY=

# Google Gemini / Veo — get an API key from https://aistudio.google.com/apikey
# Used for AI post images (Imagen) and the Veo 3 presentation videos.
# The key/project must be allow-listed for the Veo model below.
GEMINI_API_KEY=

# Veo 3 video settings (optional — sensible defaults are used if unset).
# Model: veo-3.1-generate-preview (quality), veo-3.1-fast-generate-preview
# (faster/cheaper) or veo-3.1-lite-generate-preview (cheapest). Must be a model
# your API key's project has access to — check /api/test-veo.
VEO_MODEL=veo-3.1-generate-preview
# Aspect ratio: 16:9 (landscape) or 9:16 (portrait, for Reels/TikTok/Stories).
VEO_ASPECT_RATIO=16:9
# Resolution: 720p or 1080p (1080p is 16:9 only).
VEO_RESOLUTION=720p

# WAN video generation (Alibaba Cloud Model Studio, Frankfurt).
# Required for the property-video pipeline: WAN animates the property's actual
# photographs. Verify the connection at /api/test/wan while logged in.
ALIBABA_CLOUD_API_KEY=
# Workspace id — also the subdomain of the regional endpoint.
ALIBABA_WORKSPACE_ID=
WAN_REGION=eu-central-1
# Image-to-video model. There is no "WAN 3.0" in Model Studio — the line runs
# 2.1 → 2.7 — and an unknown id makes every scene fail. Leave blank to use the
# built-in default (wan2.6-i2v-flash). Other ids that speak the same
# first-frame API: wan2.5-i2v-preview, wan2.6-i2v-plus. Wan 2.7 uses a
# different request shape and needs a client change, not just a new value.
WAN_MODEL=wan2.6-i2v-flash
# How many WAN generations may run at once for one video (1-8).
WAN_MAX_CONCURRENT_JOBS=4
# Public base URL. WAN fetches the source image over the internet, so this must
# be reachable from outside — a localhost value cannot be used for generation.
APP_URL=https://www.somevideopost.com

# AI Director model (image understanding + selection). Defaults to
# gemini-2.0-flash and uses GEMINI_API_KEY above.
AI_DIRECTOR_MODEL=gemini-2.0-flash

# Optional: path to an ffmpeg binary for final assembly. Leave unset to use the
# bundled ffmpeg-static build.
FFMPEG_PATH=

# Facebook / Instagram publishing — https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google OAuth (calendar/analytics connect) — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=https://some-rental123.vercel.app

# Google Analytics 4 — Measurement ID from https://analytics.google.com
# (Admin → Data streams → your web stream). Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# Google Search Console — verification token from the "HTML tag" method at
# https://search.google.com/search-console (the content="..." value only).
# Leave blank to omit the verification meta tag.
GOOGLE_SITE_VERIFICATION=
